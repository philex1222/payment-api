# Build output
target/

# Git history
.git/
.gitignore

# Secrets — never bake these into the image
.env
*.env

# CI/CD & GitHub config — not needed in the Docker build context
.github/
.claude/

# Infrastructure config — not part of the application image
helm/
docker-compose*.yml

# Documentation
*.md
docs/

# Logs
logs/

# IDE files
.idea/
*.iml
.vscode/
.DS_Store

# Docker files themselves (not needed in build context)
.dockerignore
Dockerfile
