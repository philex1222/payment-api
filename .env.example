# Copy this file to .env and fill in real values before running docker-compose.
# .env is gitignored — never commit real secrets.
#
# Generate a strong JWT secret (minimum 64 bytes for HS512):
#   openssl rand -hex 64

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=<replace-with-output-of: openssl rand -hex 64>

# ── Database ──────────────────────────────────────────────────────────────────
# Use a least-privilege account, not root, in production.
DB_USERNAME=payment_user
DB_PASSWORD=<strong-random-password>

# Root password for MySQL container initialisation (not used by the app at runtime)
MYSQL_ROOT_PASSWORD=<strong-random-root-password>

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=<strong-random-password>

# ── Grafana ───────────────────────────────────────────────────────────────────
# Change immediately after first login.
GF_ADMIN_PASSWORD=<strong-random-password>

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the API.
CORS_ALLOWED_ORIGINS=https://app.example.com

# ── Observability (optional) ──────────────────────────────────────────────────
# Lower to 0.1 in high-traffic production to reduce Zipkin overhead.
# MANAGEMENT_TRACING_SAMPLING_PROBABILITY=0.1
