# =============================================================================
# Secret template — PLACEHOLDER VALUES ONLY
#
# DO NOT commit real credentials. This file is a reference template showing
# the required secret structure. Real secrets must be created out-of-band,
# e.g. via `kubectl create secret generic`, a secrets manager (AWS Secrets
# Manager, Vault, Azure Key Vault), or an External Secrets operator.
#
# NEVER apply this file as-is to a real cluster.
#
# Example imperative creation:
#
#   kubectl create secret generic payment-api-db-secret \
#     --from-literal=url='jdbc:mysql://mysql:3306/payment_db?useSSL=true' \
#     --from-literal=username='appuser' \
#     --from-literal=password='<strong-random-password>' \
#     -n payment-staging
#
#   kubectl create secret generic payment-api-jwt-secret \
#     --from-literal=secret='<min-64-char-random-string-for-hs512>' \
#     -n payment-staging
#
# =============================================================================

---
# Database credentials
apiVersion: v1
kind: Secret
metadata:
  name: payment-api-db-secret
  namespace: payment-staging          # change to payment-prod for production
  labels:
    app.kubernetes.io/name: payment-api
    app.kubernetes.io/component: secret
type: Opaque
# base64-encoded PLACEHOLDER values — replace before use
# echo -n 'value' | base64
data:
  url: <BASE64_ENCODED_JDBC_URL>
  username: <BASE64_ENCODED_DB_USERNAME>
  password: <BASE64_ENCODED_DB_PASSWORD>

---
# JWT signing secret (must be >= 64 bytes for HS512)
apiVersion: v1
kind: Secret
metadata:
  name: payment-api-jwt-secret
  namespace: payment-staging          # change to payment-prod for production
  labels:
    app.kubernetes.io/name: payment-api
    app.kubernetes.io/component: secret
type: Opaque
data:
  secret: <BASE64_ENCODED_JWT_SECRET>

---
# Container registry pull secret (for GHCR private packages)
# Created with:
#   kubectl create secret docker-registry ghcr-pull-secret \
#     --docker-server=ghcr.io \
#     --docker-username=<github-actor> \
#     --docker-password=<GITHUB_TOKEN or PAT with read:packages> \
#     -n payment-staging
apiVersion: v1
kind: Secret
metadata:
  name: ghcr-pull-secret
  namespace: payment-staging
  labels:
    app.kubernetes.io/name: payment-api
    app.kubernetes.io/component: registry-credentials
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: <BASE64_ENCODED_DOCKER_CONFIG_JSON>
